  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one committing action in a panel (journal Log).",
      "html": "<div class=\"ds-root\"><button class=\"ds-btn ds-btn-primary\">Log</button></div>",
      "css": ".ds-root{--bg:#0b0e14;--panel:#11161f;--panel-2:#171e2a;--panel-3:#1e2736;--line:#222b3a;--line-strong:#314058;--text:#e6edf7;--text-2:#a9b4c7;--text-3:#8591a6;--accent:#00e5ff;--accent-text:#00e5ff;--accent-ink:#00161a;--accent-soft:rgb(0 229 255 / 0.12);--caution:#ffb020;--caution-soft:rgb(255 176 32 / 0.14);font-family:\"Space Grotesk\",ui-sans-serif,system-ui,sans-serif;background:var(--bg);padding:16px}.ds-btn{display:inline-flex;align-items:center;gap:8px;border:1px solid transparent;border-radius:5px;padding:6px 12px;font:inherit;font-size:13px;font-weight:500;cursor:pointer;transition:background-color .15s,border-color .15s,filter .15s}.ds-btn-primary{background:var(--accent);color:var(--accent-ink)}.ds-btn-primary:hover{filter:brightness(1.1)}.ds-btn-primary:active{filter:brightness(.95)}.ds-btn:focus-visible{outline:2px solid var(--accent-text);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Scenario triggers and general actions; pressed state marks the running scenario in cyan.",
      "html": "<div class=\"ds-root\"><button class=\"ds-btn ds-btn-secondary\">Cabin cold</button> <button class=\"ds-btn ds-btn-secondary\" aria-pressed=\"true\">EVA hand injury</button></div>",
      "css": ".ds-root{--bg:#0b0e14;--panel:#11161f;--panel-2:#171e2a;--panel-3:#1e2736;--line:#222b3a;--line-strong:#314058;--text:#e6edf7;--text-2:#a9b4c7;--text-3:#8591a6;--accent:#00e5ff;--accent-text:#00e5ff;--accent-ink:#00161a;--accent-soft:rgb(0 229 255 / 0.12);--caution:#ffb020;--caution-soft:rgb(255 176 32 / 0.14);font-family:\"Space Grotesk\",ui-sans-serif,system-ui,sans-serif;background:var(--panel);padding:16px}.ds-btn{display:inline-flex;align-items:center;gap:6px;border:1px solid;border-radius:5px;padding:6px 12px;font:inherit;font-size:12px;font-weight:500;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-btn-secondary{border-color:var(--line-strong);background:var(--panel-2);color:var(--text)}.ds-btn-secondary:hover{border-color:rgb(0 229 255 / .6);background:var(--panel-3)}.ds-btn-secondary[aria-pressed=true]{border-color:rgb(0 229 255 / .7);background:var(--accent-soft)}.ds-btn:focus-visible{outline:2px solid var(--accent-text);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-emphasis panel-header actions such as Reset.",
      "html": "<div class=\"ds-root\"><button class=\"ds-btn\">Reset</button></div>",
      "css": ".ds-root{--bg:#0b0e14;--panel:#11161f;--panel-2:#171e2a;--panel-3:#1e2736;--line:#222b3a;--line-strong:#314058;--text:#e6edf7;--text-2:#a9b4c7;--text-3:#8591a6;--accent:#00e5ff;--accent-text:#00e5ff;--accent-ink:#00161a;--accent-soft:rgb(0 229 255 / 0.12);--caution:#ffb020;--caution-soft:rgb(255 176 32 / 0.14);font-family:\"Space Grotesk\",ui-sans-serif,system-ui,sans-serif;background:var(--panel);padding:16px}.ds-btn{border:1px solid transparent;border-radius:5px;padding:4px 8px;font:inherit;font-size:12px;font-weight:500;cursor:pointer;background:transparent;color:var(--text-2);transition:background-color .15s}.ds-btn:hover{background:var(--panel-2);color:var(--text)}.ds-btn:focus-visible{outline:2px solid var(--accent-text);outline-offset:2px}"
    },
    {
      "name": "Journal Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Single-line text field on the raised panel tone with a cyan caret and focus border.",
      "html": "<div class=\"ds-root\"><input class=\"ds-input\" placeholder=\"How are you feeling today?\"></div>",
      "css": ".ds-root{--bg:#0b0e14;--panel:#11161f;--panel-2:#171e2a;--panel-3:#1e2736;--line:#222b3a;--line-strong:#314058;--text:#e6edf7;--text-2:#a9b4c7;--text-3:#8591a6;--accent:#00e5ff;--accent-text:#00e5ff;--accent-ink:#00161a;--accent-soft:rgb(0 229 255 / 0.12);--caution:#ffb020;--caution-soft:rgb(255 176 32 / 0.14);font-family:\"Space Grotesk\",ui-sans-serif,system-ui,sans-serif;background:var(--panel);padding:16px}.ds-input{width:260px;border:1px solid var(--line-strong);border-radius:5px;background:var(--panel-2);color:var(--text);padding:6px 12px;font:inherit;font-size:13px;caret-color:var(--accent-text)}.ds-input::placeholder{color:var(--text-3)}.ds-input:focus{outline:none;border-color:rgb(0 229 255 / .7)}"
    },
    {
      "name": "Severity Badges",
      "kind": "chip",
      "refersTo": "badge-critical",
      "description": "Nominal outline, caution amber, critical inverted ink with a pulsing dot. Never red.",
      "html": "<div class=\"ds-root\"><span class=\"ds-badge ds-nominal\"><i></i>Nominal</span><span class=\"ds-badge ds-caution\"><i></i>Caution</span><span class=\"ds-badge ds-critical\"><i class=\"ds-pulse\"></i>Critical</span></div>",
      "css": ".ds-root{--bg:#0b0e14;--panel:#11161f;--panel-2:#171e2a;--panel-3:#1e2736;--line:#222b3a;--line-strong:#314058;--text:#e6edf7;--text-2:#a9b4c7;--text-3:#8591a6;--accent:#00e5ff;--accent-text:#00e5ff;--accent-ink:#00161a;--accent-soft:rgb(0 229 255 / 0.12);--caution:#ffb020;--caution-soft:rgb(255 176 32 / 0.14);background:var(--panel);padding:16px;display:flex;gap:8px}.ds-badge{display:inline-flex;align-items:center;gap:6px;border:1px solid;border-radius:4px;padding:2px 6px;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:11px;font-weight:500;line-height:1}.ds-badge i{width:6px;height:6px;border-radius:9999px;background:currentColor}.ds-nominal{border-color:var(--line-strong);color:var(--text-3)}.ds-nominal i{opacity:.6}.ds-caution{border-color:rgb(255 176 32 / .5);background:var(--caution-soft);color:var(--caution)}.ds-critical{border-color:var(--text);background:var(--text);color:var(--bg);font-weight:600}.ds-pulse{animation:ds-p 1.4s cubic-bezier(.16,1,.3,1) infinite}@keyframes ds-p{0%,100%{opacity:1}50%{opacity:.45}}@media (prefers-reduced-motion:reduce){.ds-pulse{animation:none}}"
    },
    {
      "name": "Provenance Tags",
      "kind": "chip",
      "refersTo": "tag-neutral",
      "description": "10px uppercase mono tags for data provenance; the only uppercase in the system.",
      "html": "<div class=\"ds-root\"><span class=\"ds-tag\">Simulated</span><span class=\"ds-tag\">Team-defined</span><span class=\"ds-tag ds-tag-caution\">Verify</span></div>",
      "css": ".ds-root{--bg:#0b0e14;--panel:#11161f;--panel-2:#171e2a;--panel-3:#1e2736;--line:#222b3a;--line-strong:#314058;--text:#e6edf7;--text-2:#a9b4c7;--text-3:#8591a6;--accent:#00e5ff;--accent-text:#00e5ff;--accent-ink:#00161a;--accent-soft:rgb(0 229 255 / 0.12);--caution:#ffb020;--caution-soft:rgb(255 176 32 / 0.14);background:var(--panel);padding:16px;display:flex;gap:6px}.ds-tag{display:inline-flex;border:1px solid var(--line-strong);border-radius:4px;padding:2px 6px;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:10px;font-weight:500;line-height:1;letter-spacing:.04em;text-transform:uppercase;color:var(--text-2)}.ds-tag-caution{border-color:rgb(255 176 32 / .4);background:var(--caution-soft);color:var(--caution)}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Hairline panel with a 44px title header; status rows pair a category swatch with a label.",
      "html": "<section class=\"ds-panel\"><header><h2>Crew status</h2><span class=\"ds-tag\">Simulated</span></header><div class=\"ds-body\"><div class=\"ds-row\"><span class=\"ds-sw\" style=\"background:#00FF90\"></span>Radiation<span class=\"ds-muted\">Nominal</span></div><div class=\"ds-row\"><span class=\"ds-sw\" style=\"background:#4D7CFF;box-shadow:0 0 10px 1px #4D7CFF\"></span><b>Cabin cold</b><span class=\"ds-amber\">Caution</span></div></div></section>",
      "css": ".ds-panel{--bg:#0b0e14;--panel:#11161f;--panel-2:#171e2a;--panel-3:#1e2736;--line:#222b3a;--line-strong:#314058;--text:#e6edf7;--text-2:#a9b4c7;--text-3:#8591a6;--accent:#00e5ff;--accent-text:#00e5ff;--accent-ink:#00161a;--accent-soft:rgb(0 229 255 / 0.12);--caution:#ffb020;--caution-soft:rgb(255 176 32 / 0.14);font-family:\"Space Grotesk\",ui-sans-serif,system-ui,sans-serif;width:300px;background:var(--panel);color:var(--text);border:1px solid var(--line);border-radius:6px;box-shadow:0 1px 2px rgb(0 0 0 / .4),0 8px 24px -12px rgb(0 0 0 / .6)}.ds-panel header{display:flex;align-items:center;justify-content:space-between;min-height:44px;padding:8px 16px;border-bottom:1px solid var(--line);box-sizing:border-box}.ds-panel h2{margin:0;font-size:14px;font-weight:600;letter-spacing:-.01em}.ds-tag{border:1px solid var(--line-strong);border-radius:4px;padding:2px 6px;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:var(--text-2)}.ds-body{padding:16px}.ds-row{display:flex;align-items:center;gap:10px;padding:6px 0;font-size:13px;border-top:1px solid var(--line)}.ds-row:first-child{border-top:0}.ds-sw{width:10px;height:10px;border-radius:9999px}.ds-muted,.ds-amber{margin-left:auto;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:11px}.ds-muted{color:var(--text-3)}.ds-amber{color:var(--caution)}"
    },
    {
      "name": "Segmented Tabs",
      "kind": "nav",
      "refersTo": "segmented-tab-active",
      "description": "Panel-level view switch on a raised track.",
      "html": "<div class=\"ds-root\"><div class=\"ds-seg\" role=\"tablist\"><button role=\"tab\" aria-selected=\"true\">Active · 1</button><button role=\"tab\" aria-selected=\"false\">Log</button></div></div>",
      "css": ".ds-root{--bg:#0b0e14;--panel:#11161f;--panel-2:#171e2a;--panel-3:#1e2736;--line:#222b3a;--line-strong:#314058;--text:#e6edf7;--text-2:#a9b4c7;--text-3:#8591a6;--accent:#00e5ff;--accent-text:#00e5ff;--accent-ink:#00161a;--accent-soft:rgb(0 229 255 / 0.12);--caution:#ffb020;--caution-soft:rgb(255 176 32 / 0.14);font-family:\"Space Grotesk\",ui-sans-serif,system-ui,sans-serif;background:var(--panel);padding:16px}.ds-seg{display:inline-flex;gap:2px;padding:2px;border-radius:5px;background:var(--panel-2)}.ds-seg button{border:0;border-radius:4px;padding:2px 8px;font:inherit;font-size:12px;background:transparent;color:var(--text-3);cursor:pointer;transition:color .15s}.ds-seg button:hover{color:var(--text)}.ds-seg button[aria-selected=true]{background:var(--panel-3);color:var(--text)}.ds-seg button:focus-visible{outline:2px solid var(--accent-text);outline-offset:2px}"
    },
    {
      "name": "Body Callout",
      "kind": "custom",
      "refersTo": "body-callout",
      "description": "Signature: marker on the model, leader line, glass label; tracks the body as it rotates.",
      "html": "<div class=\"ds-void\"><div class=\"ds-callout ds-up\"><span class=\"ds-label\">Right hand <b>· critical</b></span><span class=\"ds-line\"></span><span class=\"ds-dot ds-pulse\"></span></div><div class=\"ds-callout ds-side\" style=\"--c:#4D7CFF\"><span class=\"ds-dot\"></span><span class=\"ds-line\"></span><span class=\"ds-label\">Cabin cold <em>· caution</em></span></div></div>",
      "css": ".ds-void{--c:#FF3366;background:#05070c;padding:32px;display:flex;gap:48px;align-items:center;border-radius:6px}.ds-callout{display:flex;align-items:center}.ds-up{flex-direction:column}.ds-up .ds-line{width:1px;height:40px}.ds-side .ds-line{width:40px;height:1px}.ds-dot{width:8px;height:8px;border-radius:9999px;background:var(--c);box-shadow:0 0 8px 1px var(--c)}.ds-line{background:var(--c);opacity:.8}.ds-label{white-space:nowrap;border:1px solid color-mix(in srgb,var(--c) 60%,transparent);border-radius:4px;background:rgb(8 11 17 / .86);padding:4px 8px;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:11px;line-height:1;color:#e6edf7}.ds-label b{color:#fff;font-weight:600}.ds-label em{font-style:normal;color:#ffc861}.ds-pulse{animation:ds-p 1.4s cubic-bezier(.16,1,.3,1) infinite}@keyframes ds-p{0%,100%{opacity:1}50%{opacity:.45}}@media (prefers-reduced-motion:reduce){.ds-pulse{animation:none}}"
    },
    {
      "name": "Telemetry Readout",
      "kind": "custom",
      "refersTo": "telemetry-readout",
      "description": "Label, mono value with unit, 60 s trace and dashed caution threshold.",
      "html": "<div class=\"ds-root\"><div class=\"ds-cell\"><p class=\"ds-l\">CO₂</p><p class=\"ds-v\">2.2 <span>mmHg</span></p><svg viewBox=\"0 0 120 32\" preserveAspectRatio=\"none\"><line x1=\"0\" x2=\"120\" y1=\"10\" y2=\"10\" stroke=\"#ffb020\" stroke-dasharray=\"3 3\" opacity=\".7\" vector-effect=\"non-scaling-stroke\"/><path d=\"M0,24L20,23L40,25L60,22L80,24L100,21L120,22\" fill=\"none\" stroke=\"#a9b4c7\" stroke-width=\"1.5\" vector-effect=\"non-scaling-stroke\"/></svg></div></div>",
      "css": ".ds-root{--bg:#0b0e14;--panel:#11161f;--panel-2:#171e2a;--panel-3:#1e2736;--line:#222b3a;--line-strong:#314058;--text:#e6edf7;--text-2:#a9b4c7;--text-3:#8591a6;--accent:#00e5ff;--accent-text:#00e5ff;--accent-ink:#00161a;--accent-soft:rgb(0 229 255 / 0.12);--caution:#ffb020;--caution-soft:rgb(255 176 32 / 0.14);font-family:\"Space Grotesk\",ui-sans-serif,system-ui,sans-serif;background:var(--panel);padding:16px}.ds-cell{width:120px;padding:10px 12px}.ds-l{margin:0;font-size:11px;color:var(--text-3)}.ds-v{margin:2px 0 0;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:18px;font-weight:500;line-height:1;font-variant-numeric:tabular-nums;color:var(--text)}.ds-v span{font-size:11px;font-weight:400;color:var(--text-3)}.ds-cell svg{display:block;margin-top:6px;width:100%;height:32px}"
    }
  ],
  "narrative": {
    "northStar": "The Body Is the Display",
    "overview": "A.U.R.A. is a telemetry HUD built around one object: NASA's astronaut model standing in a dark observation window, wearing its hazards as coloured auras. Everything else is instrumentation that explains what the body shows. The surrounding panels are quiet, tonal and hairline-ruled so the only saturated colour on a calm screen comes from a hazard, and on a nominal screen there is almost none.\n\nThe world descends from the user-pinned Google Stitch telemetry mocks: an ink ground with stepped panel tones, 1px hairlines, tight 6px corners, Space Grotesk for words and JetBrains Mono for anything measured. It is dense in the way an operations console is dense: three columns, small type, every number tabular, nothing decorative that does not carry state. A light theme swaps the ground for cool porcelain, but the 3D viewport stays a dark observation window in both, because an aura needs a dark ground to read.\n\nRejected by the direction contract: a grid of KPI tiles with a 3D toy in a corner. The model is the centre of the layout, not an accessory to it.",
    "keyCharacteristics": [
      "Colour means hazard category; severity is carried by intensity and label, never by hue.",
      "Cyan is the hand of the operator: interaction, focus, selection, and the viewport's instrument framing.",
      "Flat tonal panels with a soft ambient shadow; depth comes from the observation window, not from cards.",
      "Mono for readouts, units, badges and labels; grotesk for titles and prose.",
      "Body-anchored callouts with leader lines are the signature move."
    ],
    "rules": [
      {
        "name": "The Category-Only Colour Rule",
        "body": "A saturated hue on screen means a hazard category, read from `CATEGORY_META`. If a colour is not a category and not cyan or amber, it is a neutral.",
        "section": "colors"
      },
      {
        "name": "The Red Is Injury Rule",
        "body": "Red never encodes severity, because red means injury. Critical is shown by pulsing aura plus an inverted ink badge (ink fill, ground-colour text), never by turning things red.",
        "section": "colors"
      },
      {
        "name": "The Cyan Is the Operator Rule",
        "body": "Signal Cyan marks what the user can touch, what has focus and what is selected. A cyan number or chart is a bug.",
        "section": "colors"
      },
      {
        "name": "The Measured-Is-Mono Rule",
        "body": "Values, units, clocks, thresholds, badges and log lines use JetBrains Mono with tabular numerals; titles and prose never do.",
        "section": "typography"
      },
      {
        "name": "The Uppercase-Is-Provenance Rule",
        "body": "Uppercase is reserved for the 10px provenance tag. Panel titles and labels stay sentence case; there are no eyebrows or kickers above titles.",
        "section": "typography"
      },
      {
        "name": "The One Window Rule",
        "body": "Volume, glow and darkness belong to the observation window. Panels stay flat and tonal in both themes.",
        "section": "elevation"
      },
      {
        "name": "The Brackets Are the Window Rule",
        "body": "Corner brackets mark the observation window only; no panel, card or button gets them.",
        "section": "shapes"
      },
      {
        "name": "The Even Border Rule",
        "body": "Borders are uniform 1px on all sides. No coloured side stripes on cards, alerts or rows; category identity comes from the swatch beside the label.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** read every category colour from `CATEGORY_META` in `backend/config/aura.ts`; that file is the only place they live.",
      "**Do** carry severity by intensity and words: no aura or outline badge at nominal, steady amber at caution, pulsing aura plus inverted ink badge at critical.",
      "**Do** keep the 3D viewport on observation-void (#05070c via the token) in both themes, framed by corner brackets.",
      "**Do** pair every colour swatch with a text label; colour is never the only signal.",
      "**Do** set every measured value in JetBrains Mono with tabular numerals.",
      "**Do** honour reduced motion: auto-rotation and pulses stop."
    ],
    "donts": [
      "**Don't** use red, or any colour, to mean severity; red means injury.",
      "**Don't** use Signal Cyan for data, charts or readings.",
      "**Don't** hard-code a category hex in frontend code or add a new hue outside the category set.",
      "**Don't** put corner brackets on anything but the viewport frame.",
      "**Don't** use coloured side borders on cards, alerts or rows.",
      "**Don't** put eyebrows or kickers above panel titles.",
      "**Don't** pulse telemetry numbers; the pulse belongs to auras, callout markers and critical badge dots."
    ]
  }
}
